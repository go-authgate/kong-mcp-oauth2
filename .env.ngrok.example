# ngrok public-demo settings (NGROK.zh-TW.md). Copy to .env:
#
#   cp .env.ngrok.example .env
#
# .env is read by docker compose for variable interpolation and is gitignored.

# Kong must load the sed-generated local config (NGROK.zh-TW.md §4),
# not the placeholder kong.yml.
KONG_CONFIG=./kong.ngrok.local.yml
